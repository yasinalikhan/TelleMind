# ==============================================================================
# TeleMind Monorepo Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
*.swp
*~

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDE & Editor Configurations
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Frontend Build Outputs
node_modules/
dist/
.angular/
tmp/
out-tsc/

# Java / Maven Backend Build Outputs
target/
*.jar
*.war
*.ear
*.class

# Test Coverage
coverage/
.nyc_output/

# Docker Local Data
telemind_pgdata/
